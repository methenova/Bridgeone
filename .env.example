# ==============================================================================
# BridgeOne Environment Configuration Template (.env.example)
# Copy this file to .env and replace placeholder values with your actual config.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. FRONTEND SUPABASE CLIENT CONFIGURATION (Required)
# ------------------------------------------------------------------------------

# Project API URL from Supabase Project Settings -> API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Public Anon Key (safe for client-side bundle exposure)
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# ------------------------------------------------------------------------------
# 2. HIGH AVAILABILITY & REGIONAL FAILOVER (Optional)
# ------------------------------------------------------------------------------

# Secondary regional replica endpoint for database failover.
# Leave blank or omit if operating in single-region mode.
VITE_SUPABASE_BACKUP_URL=https://your-backup-region-ref.supabase.co

# ------------------------------------------------------------------------------
# 3. APPLICATION & VIDEO PROVIDER CONFIGURATION (Optional)
# ------------------------------------------------------------------------------

# Base URL for custom backend API services (Default: http://localhost:3000/api)
VITE_API_URL=http://localhost:3000/api

# WebRTC Video Provider engine selection: 'webrtc', 'daily', or 'agora'
VITE_VIDEO_PROVIDER=webrtc

# ==============================================================================
# EDGE FUNCTIONS SECRETS & SERVER-SIDE CONFIGURATION
# Set these secrets in Supabase CLI or Dashboard: supabase secrets set KEY=VALUE
# ==============================================================================

# ------------------------------------------------------------------------------
# 4. SUPABASE ADMIN & SERVICE ROLE (Injected automatically by Edge Runtime)
# ------------------------------------------------------------------------------
# SUPABASE_URL=https://your-project-ref.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ------------------------------------------------------------------------------
# 5. STRIPE PAYMENT & SUBSCRIPTION INTEGRATION
# ------------------------------------------------------------------------------

# Stripe Secret API Key (sk_test_... or sk_live_...)
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key

# Stripe Webhook Signing Secret (whsec_...) from Stripe Dashboard -> Webhooks
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret

# Stripe Price ID for Growth Subscription Plan
STRIPE_PRICE_GROWTH=price_1Nx...

# Stripe Price ID for Enterprise Subscription Plan
STRIPE_PRICE_ENTERPRISE=price_1Ny...

# ------------------------------------------------------------------------------
# 6. WEBRTC TURN / STUN MEDIA SERVER CREDENTIALS
# ------------------------------------------------------------------------------

# Coturn Shared Secret (HMAC-SHA1 RFC 5766) for temporary TURN credential generation
COTURN_SHARED_SECRET=your_coturn_shared_secret_key

# ------------------------------------------------------------------------------
# 7. TRANSACTIONAL NOTIFICATIONS (Email & SMS)
# ------------------------------------------------------------------------------

# SendGrid API Key for transactional email delivery
SENDGRID_API_KEY=SG.your_sendgrid_api_key

# Sender Email Address for SendGrid notifications
SENDGRID_FROM_EMAIL=notifications@bridgeone.co

# Twilio Account SID for SMS notifications
TWILIO_ACCOUNT_SID=ACyour_twilio_account_sid

# Twilio Auth Token for SMS notifications
TWILIO_AUTH_TOKEN=your_twilio_auth_token

# Twilio Phone Number (E.164 format, e.g., +1234567890)
TWILIO_FROM_NUMBER=+1234567890
